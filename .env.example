# Google Gemini — required for LLM (chat responses)
# Get free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Embeddings are local (HuggingFace all-MiniLM-L6-v2) — no key needed

# Optional overrides (defaults shown)
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=512
CHROMA_PERSIST_DIR=./data/processed/chroma_db
RETRIEVER_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MEMORY_WINDOW_K=6
